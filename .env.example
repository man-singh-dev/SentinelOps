# Postgres - consumed directly by the postgres compose service, and
# recombined into DATABASE_URL below for the api service and migrations.
POSTGRES_USER=sentinelops
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=sentinelops

# RabbitMQ - consumed directly by the rabbitmq compose service.
# Phase 2: credentials are set here before any application code connects,
# so the broker is configured consistently from the first time it starts.
RABBITMQ_DEFAULT_USER=sentinelops
RABBITMQ_DEFAULT_PASS=devpassword

# API
# NODE_ENV defaults to development if unset - only needs to be set

NODE_ENV=development
API_PORT=3000
DATABASE_URL=postgres://sentinelops:devpassword@postgres:5432/sentinelops?sslmode=disable
# AMQP connection URL for the API to reach the RabbitMQ broker.
RABBITMQ_URL=amqp://sentinelops:devpassword@rabbitmq:5672
LOG_LEVEL=info
# Origin allowed to call the API via CORS - this is the web app's origin,
# not the API's own.
CORS_ORIGIN=http://localhost:5173

# Worker
# Phase 0: the worker only heartbeats, so this is its entire config surface.
# DATABASE_URL/queue config are added here when the worker has real work to do.
WORKER_LOG_LEVEL=info

# Web (Vite requires the VITE_ prefix to expose a var to client code)
VITE_API_URL=http://localhost:3000

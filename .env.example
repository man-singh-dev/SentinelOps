# Postgres - consumed directly by the postgres compose service, and
# recombined into DATABASE_URL below for the api service and migrations.
POSTGRES_USER=sentinelops
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=sentinelops

# API
API_PORT=3000
DATABASE_URL=postgres://sentinelops:devpassword@postgres:5432/sentinelops
LOG_LEVEL=info

# Worker
# Phase 0: the worker only heartbeats, so this is its entire config surface.
# DATABASE_URL/queue config are added here when the worker has real work to do.
WORKER_LOG_LEVEL=info

# Web (Vite requires the VITE_ prefix to expose a var to client code)
VITE_API_URL=http://localhost:3000
